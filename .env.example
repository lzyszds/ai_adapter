# =============================================================================
# LLM-Shield 环境变量
# 用法：cp .env.example .env 后按需修改
# =============================================================================

# -----------------------------------------------------------------------------
# Docker 镜像（默认 Docker Hub；服务器无需 .env 也能拉 lzyszds/ai_adapter:v1）
# -----------------------------------------------------------------------------
DOCKER_IMAGE=lzyszds/ai_adapter:v1

# -----------------------------------------------------------------------------
# Docker 部署 — MySQL（docker-compose.prod.yml 会读取）
# 服务器部署时务必修改 MYSQL_ROOT_PASSWORD
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=llm_shield
MYSQL_USER=root

# -----------------------------------------------------------------------------
# 代理与上游
# -----------------------------------------------------------------------------
# 上游中转站地址
UPSTREAM_URL=https://llm.goaichat.top

# 可选：服务端固定上游 Key；留空则 Claude / 仪表盘均使用客户端填入的上游 Key
UPSTREAM_API_KEY=

# -----------------------------------------------------------------------------
# 本地 pnpm dev 专用（服务器 Docker 部署不要写下面两行！）
# Docker 部署时 DATABASE_URL / REDIS_URL 由 compose 自动注入为 mysql / redis
# -----------------------------------------------------------------------------
# PORT=3000
# DATABASE_URL="mysql://root:root@localhost:3306/llm_shield?connection_limit=20"
# REDIS_URL=redis://localhost:6379

# 缓冲刷新周期（毫秒）
FLUSH_INTERVAL_MS=5000
FLUSH_BATCH_SIZE=500

# 统计缓存 TTL（毫秒）
STATS_CACHE_TTL_MS=10000

# 流式请求空闲超时（毫秒）
STREAM_IDLE_TIMEOUT_MS=120000

LOG_LEVEL=info
