# API 服务端口
PORT=3000

# 上游中转站地址（保留原本地代理的 goaichat）
UPSTREAM_URL=https://llm.goaichat.top

# 可选：固定上游鉴权；留空则透传客户端 Authorization
UPSTREAM_API_KEY=

# 可选：客户端访问本代理所需的 Bearer Key；留空则不鉴权
PROXY_API_KEY=

# MySQL（connection_limit 用于高并发下的连接池）
DATABASE_URL="mysql://root:root@localhost:3306/llm_shield?connection_limit=20"

# Redis
REDIS_URL=redis://localhost:6379

# 缓冲刷新周期（毫秒）
FLUSH_INTERVAL_MS=5000

# 统计缓存 TTL（毫秒）
STATS_CACHE_TTL_MS=10000

LOG_LEVEL=info